# The image copies the jar the Maven build produced rather than building inside Docker: the build
# already runs reproducibly in CI, and a second build inside an image is a second thing to trust.
FROM eclipse-temurin:21-jre

RUN useradd --system --uid 10001 --create-home app
WORKDIR /app
COPY gateway-app/target/gateway-app-0.1.0-SNAPSHOT-exec.jar /app/app.jar
USER app

EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/app.jar"]
