# Builds the gateway from source, for hosts that cannot run Maven before a Docker build
# (Render, Koyeb and other PaaS Docker deploys). The compose stack uses Dockerfile.gateway,
# which copies the jar the Maven build already produced.
FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /src
COPY pom.xml ./
COPY ledger-core ledger-core
COPY policy-core policy-core
COPY payments-core payments-core
COPY sim sim
COPY mandate-cli mandate-cli
COPY gateway-app gateway-app
COPY psp-sim psp-sim

RUN mvn -B -pl gateway-app -am -DskipTests package

FROM eclipse-temurin:21-jre

RUN useradd --system --uid 10001 --create-home app
WORKDIR /app
COPY --from=build /src/gateway-app/target/gateway-app-0.1.0-SNAPSHOT-exec.jar /app/app.jar
USER app

EXPOSE 8080
ENTRYPOINT ["java", "-XX:MaxRAMPercentage=70", "-jar", "/app/app.jar"]
